              "id": "tr-about-hero-copy-w",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tr-about-hero\" style=\"display:block\"><div class=\"copy-side\"><span class=\"tr-label\">Who we are<\/span><h1>The Rabbi Who <span class=\"accent\">Trains.<\/span><\/h1><p class=\"lede\">Former IDF combat soldier. Ordained rabbi. NRA-certified instructor. The Tactical Rabbi is where faith, discipline, and real-world preparedness meet.<\/p><div class=\"actions\"><a class=\"tr-btn coyote\" href=\"/courses\">Browse Courses<\/a><a class=\"tr-btn ghost\" href=\"/contact\">Book a Session<\/a><\/div><\/div><\/div>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tr-bio-section",
      "elType": "section",
      "settings": {
        "padding": {"unit":"px","top":"70","right":"48","bottom":"70","left":"48","isLinked":false}
