      "elType": "section",
      "settings": {
        "padding": {"unit":"px","top":"64","right":"48","bottom":"64","left":"48","isLinked":false}
      },
      "elements": [
        {
          "id": "tr-contact-form-col",
          "elType": "column",
          "settings": {"_column_size":55},
          "elements": [
            {
              "id": "tr-contact-form-w",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tr-form-panel\"><h2>Send a message<\/h2><p style=\"color:var(--muted);font-size:14px;margin-bottom:28px\">Fields marked with * are required.<\/p><form method=\"post\" action=\"#\"><div class=\"tr-form-row\"><div class=\"tr-field\"><label>First Name *<\/label><input type=\"text\" name=\"first_name\" placeholder=\"John\" required><\/div><div class=\"tr-field\"><label>Last Name *<\/label><input type=\"text\" name=\"last_name\" placeholder=\"Smith\" required><\/div><\/div><div class=\"tr-form-row\"><div class=\"tr-field\"><label>Email *<\/label><input type=\"email\" name=\"email\" placeholder=\"john@example.com\" required><\/div><div class=\"tr-field\"><label>Phone<\/label><input type=\"tel\" name=\"phone\" placeholder=\"(555) 123-4567\"><\/div><\/div><div class=\"tr-field\"><label>I'm interested in *<\/label><select name=\"interest\"><option>General Inquiry<\/option><option>Tactical Pistol<\/option><option>Advanced Tactical Pistol<\/option><option>Tactical Rifle<\/option><option>Advanced Tactical Rifle<\/option><option>Active Shooter Response<\/option><option>Private Lesson<\/option><option>Security Assessment (Schools \/ Synagogues)<\/option><option>Speaking Engagement<\/option><option>Press \/ Media<\/option><\/select><\/div><div class=\"tr-field\"><label>Message *<\/label><textarea name=\"message\" placeholder=\"Tell us a bit about what you're looking for...\" required><\/textarea><\/div><button type=\"submit\" class=\"tr-btn coyote\" style=\"width:100%;padding:14px;font-size:15px;border-radius:8px;font-family:'Space Grotesk';font-weight:700\">Send Message<\/button><p style=\"font-size:12.5px;color:var(--muted);margin-top:14px;text-align:center\">We typically respond within 48 hours. For urgent scheduling, call us directly.<\/p><\/form><\/div>"
              }
            }
          ]
        },
        {
          "id": "tr-contact-sidebar-col",
          "elType": "column",
          "settings": {"_column_size":45},
          "elements": [
            {
              "id": "tr-contact-sidebar-w",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"display:flex;flex-direction:column;gap:18px\"><div class=\"tr-info-card\"><div style=\"display:flex;align-items:flex-start;gap:14px;margin-bottom:18px\"><div class=\"tr-icon-badge\">☎<\/div><div><h4 style=\"font-size:14px;margin-bottom:3px\">Call Us<\/h4><a href=\"tel:+17608333711\" style=\"font-size:13.5px;color:var(--muted);text-decoration:none\">(760) 833-3711<\/a><\/div><\/div><div style=\"display:flex;align-items:flex-start;gap:14px\"><div class=\"tr-icon-badge\">✉<\/div><div><h4 style=\"font-size:14px;margin-bottom:3px\">Email Response Time<\/h4><p style=\"font-size:13.5px;color:var(--muted)\">We usually respond within 48 hours.<\/p><\/div><\/div><\/div><div class=\"tr-info-card dark\"><h3 style=\"font-size:17px;margin-bottom:10px\">Follow Along<\/h3><p style=\"font-size:13.5px;line-height:1.6;margin-bottom:16px\">30M+ views of real training, drills, and preparedness content — see what a session actually looks like before you book.<\/p><div style=\"display:flex;gap:10px\"><a class=\"tr-social-chip\" href=\"https://youtube.com\" target=\"_blank\">YouTube<\/a><a class=\"tr-social-chip\" href=\"https://instagram.com\" target=\"_blank\">Instagram<\/a><a class=\"tr-social-chip\" href=\"https://facebook.com\" target=\"_blank\">Facebook<\/a><\/div><\/div><\/div>"
              }
            }
          ]
        }
      ]
