                "html": "<div class=\"tr-hero\" style=\"background:url('/wp-content/uploads/hero-bg.jpg') center/cover no-repeat;\"><div class=\"tr-hero-wash\"><\/div><div class=\"tr-hero-content\"><div class=\"tr-hero-tag\"><span class=\"dot\"><\/span><span>Tactical Training · Faith-Driven · Real-World Ready<\/span><\/div><h1>Train With <span class=\"accent\">Purpose.<\/span><\/h1><p class=\"sub\">Israel-trained. Combat-experienced. Teaching civilians to survive what they hope never happens.<\/p><div class=\"actions\"><a class=\"tr-btn coyote lg\" href=\"/courses\">Browse Courses<\/a><a class=\"tr-btn ghost lg\" href=\"/about\" style=\"color:#fff;border-color:#fff\">Meet the Rabbi<\/a><\/div><div class=\"tr-stat-row\"><div class=\"tr-stat\"><div class=\"num\">30M+<\/div><div class=\"stat-label\">Views<\/div><\/div><div class=\"tr-stat\"><div class=\"num\">2,000+<\/div><div class=\"stat-label\">Students Trained<\/div><\/div><div class=\"tr-stat\"><div class=\"num\">15+<\/div><div class=\"stat-label\">Years Experience<\/div><\/div><\/div><\/div><\/div>"
