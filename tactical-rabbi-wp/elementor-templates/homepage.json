                "html": "<div class=\"tr-course-grid\"><div class=\"tr-course-card\"><img src=\"/wp-content/uploads/course-tactical-pistol.jpg\" alt=\"Tactical Pistol\"><div class=\"body\"><span class=\"tag-mini\">Pistol<\/span><h3>Tactical Pistol<\/h3><div class=\"meta\"><span>4 hrs<\/span><span>Beginner<\/span><\/div><div class=\"price\">$275<\/div><a class=\"view-btn\" href=\"/courses/tactical-pistol\">View Course →<\/a><\/div><\/div><div class=\"tr-course-card\"><img src=\"/wp-content/uploads/course-tactical-rifle.jpg\" alt=\"Tactical Rifle\"><div class=\"body\"><span class=\"tag-mini\">Rifle<\/span><h3>Tactical Rifle<\/h3><div class=\"meta\"><span>4 hrs<\/span><span>Beginner<\/span><\/div><div class=\"price\">$275<\/div><a class=\"view-btn\" href=\"/courses/tactical-rifle\">View Course →<\/a><\/div><\/div><div class=\"tr-course-card\"><img src=\"/wp-content/uploads/course-active-shooter.jpg\" alt=\"Active Shooter Response\"><div class=\"body\"><span class=\"tag-mini\">Response<\/span><h3>Active Shooter Response<\/h3><div class=\"meta\"><span>4 hrs<\/span><span>All Levels<\/span><\/div><div class=\"price\">$275<\/div><a class=\"view-btn\" href=\"/courses/active-shooter-response\">View Course →<\/a><\/div><\/div><div class=\"tr-course-card\"><img src=\"/wp-content/uploads/course-stress-box.jpg\" alt=\"Stress Box\"><div class=\"body\"><span class=\"tag-mini\">Shoot House<\/span><h3>Stress Box<\/h3><div class=\"meta\"><span>4 hrs<\/span><span>Advanced<\/span><\/div><div class=\"price\">$350<\/div><a class=\"view-btn\" href=\"/courses/stress-box\">View Course →<\/a><\/div><\/div><\/div>"
